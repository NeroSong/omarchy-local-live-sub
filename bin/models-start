#!/usr/bin/env python3
"""Keep two local inference processes alive; Ctrl+C stops only these children."""
import argparse
import json
import os
from pathlib import Path
import signal
import socket
import subprocess
import sys
import time
import urllib.request

from model_assets import asr_directory, translation_path
from app_paths import AppPaths
from lifecycle import acquire_lock, atomic_json, create_token, identity, private_directory, private_open, remove_owned

ROOT = Path(__file__).resolve().parent.parent

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--cpu", action="store_true", help="disable GPU explicitly")
    parser.add_argument("--decoder", choices=["greedy", "hotword_ctc"], help="override asr-config.json; greedy restores the original sherpa-onnx path")
    args = parser.parse_args()
    paths = AppPaths(ROOT)
    paths.initialize()
    state = paths.state
    try:
        guard = acquire_lock(state / "models.lock", blocking=False)
    except BlockingIOError:
        raise RuntimeError("Model supervisor is already running or starting. No existing service was changed.")
    # Keep the open flock across validation, startup and all child cleanup.
    with guard:
        supervise(paths, args)


def supervise(paths, args):
    state = paths.state
    config_dir = paths.config
    asr_config = json.loads((config_dir / "asr-config.json").read_text())
    decoder = args.decoder or os.environ.get("SENSEVOICE_DECODER", asr_config["decoder"])
    if decoder not in ("greedy", "hotword_ctc"):
        raise ValueError("Unsupported decoder: " + decoder)
    child_env = os.environ.copy()
    child_env["SENSEVOICE_DECODER"] = decoder
    manifest = paths.runtime / "manifest.json"
    config = json.loads(manifest.read_text()) if manifest.exists() else {}
    cpu = args.cpu or config.get("acceleration") == "cpu"
    asr_python = paths.runtime / ("hotword-venv/bin/python" if decoder == "hotword_ctc" else "sensevoice-venv/bin/python")
    asr_server = paths.root / "bin/sensevoice-server"
    llama = paths.runtime / "llama.cpp/build/bin/llama-server"
    asr = asr_directory(paths.root)
    translation = translation_path(paths.root)
    for path in [asr_python, asr_server, llama, asr / "model.onnx", asr / "tokens.txt", translation]:
        if not path.is_file():
            raise RuntimeError(f"Missing {path}. Run live-sub --setup (package) or ./bin/setup (source) first.")
    # Overrides exist for isolated tests; the app and bin/start use the default ports.
    ports = [int(os.environ.get("LIVE_SUB_ASR_PORT", "8178")), int(os.environ.get("LIVE_SUB_TRANSLATION_PORT", "8179"))]
    if not all(1 <= port <= 65535 for port in ports):
        raise ValueError("Model service ports must be between 1 and 65535")
    reservations = []
    try:
        for port in ports:
            sock = socket.socket()
            reservations.append(sock)
            # Connections that just closed leave TIME_WAIT; a live listener still fails the bind.
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            sock.bind(("127.0.0.1", port))
    except OSError as error:
        raise RuntimeError(f"Local model port is unavailable: {error}. No existing service was stopped.")
    finally:
        for sock in reservations:
            sock.close()
    child_env["SENSEVOICE_MODEL_DIR"] = str(asr)
    # A fresh token per run: other local users and web pages cannot call the loopback services.
    create_token(paths.token)
    child_env["LIVE_SUB_API_TOKEN_FILE"] = str(paths.token)
    commands = [
        [str(asr_python), str(asr_server)],
        [str(llama), "--host", "127.0.0.1", "--port", str(ports[1]), "-m", str(translation),
         "--alias", "translator", "--api-key-file", str(paths.token), "-c", "4096", "-t", "6", "-ngl", "0" if cpu else "99", "--parallel", "1"]
    ]
    private_directory(paths.logs)
    children, logs = [], []
    pidfile = state / "models-process.json"
    record = identity(paths.root, config_dir)
    stopped = False
    def stop(_signal, _frame):
        nonlocal stopped
        stopped = True
    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)
    try:
        for name, command in zip(["asr", "translation"], commands):
            if stopped:
                break
            log = private_open(paths.logs / f"{name}.log", "w")
            logs.append(log)
            children.append(subprocess.Popen(command, stdout=log, stderr=log, env=child_env))
        if not stopped:
            atomic_json(pidfile, record)
        print(f"Loading models (SenseVoice {decoder} CPU + translation {'CPU' if cpu else 'Vulkan'}). Logs: {paths.logs}", flush=True)
        deadline = time.monotonic() + 180
        ready = False
        while not stopped:
            if any(child.poll() is not None for child in children):
                raise RuntimeError("A model process exited. Inspect the private state logs directory; no automatic CPU fallback was used.")
            if not ready:
                try:
                    # Bypass external proxies for local model checks.
                    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
                    for url in [f"http://127.0.0.1:{ports[0]}/", f"http://127.0.0.1:{ports[1]}/health"]:
                        with opener.open(url, timeout=1) as response:
                            if response.status != 200:
                                raise OSError("Not ready")
                    ready = True
                    print("Both models ready. Run bin/run. Ctrl+C here stops both model services.", flush=True)
                except OSError:
                    if time.monotonic() > deadline:
                        raise RuntimeError("Model startup timed out. Inspect the private state logs directory.")
            time.sleep(0.5)
    finally:
        for child in children:
            if child.poll() is None:
                child.terminate()
        for child in children:
            try:
                child.wait(timeout=8)
            except subprocess.TimeoutExpired:
                child.kill()
                child.wait()
        for log in logs:
            log.close()
        remove_owned(pidfile, record)
        paths.token.unlink(missing_ok=True)

if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, ValueError) as error:
        sys.exit(str(error))
