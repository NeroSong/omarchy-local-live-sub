#!/usr/bin/env python3
"""Keep two local inference processes alive; Ctrl+C stops only these children."""
import argparse
import json
import os
from pathlib import Path
import signal
import socket
import subprocess
import sys
import time
import urllib.request

ROOT = Path(__file__).resolve().parent.parent

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--cpu", action="store_true", help="disable GPU explicitly")
    args = parser.parse_args()
    manifest = ROOT / "runtime/manifest.json"
    config = json.loads(manifest.read_text()) if manifest.exists() else {}
    cpu = args.cpu or config.get("acceleration") == "cpu"
    asr_python = ROOT / "runtime/sensevoice-venv/bin/python"
    asr_server = ROOT / "bin/sensevoice-server"
    llama = ROOT / "runtime/llama.cpp/build/bin/llama-server"
    bundled = ROOT / "models/sensevoice-small-fp32"
    asr = Path(os.environ.get("SENSEVOICE_MODEL_DIR", bundled if bundled.is_dir() else Path.home() / ".local/share/voxtype/models/sensevoice-small-fp32"))
    translation = Path(os.environ.get("TRANSLATION_MODEL_PATH", ROOT / "models/translation.gguf"))
    for path in [asr_python, asr_server, llama, asr / "model.onnx", asr / "tokens.txt", translation]:
        if not path.is_file():
            raise RuntimeError(f"Missing {path}. Run bin/bootstrap first.")
    reservations = []
    try:
        for port in [8178, 8179]:
            sock = socket.socket()
            sock.bind(("127.0.0.1", port))
            reservations.append(sock)
    except OSError as error:
        raise RuntimeError(f"Local model port is unavailable: {error}. No existing service was stopped.")
    finally:
        for sock in reservations:
            sock.close()
    commands = [
        [str(asr_python), str(asr_server)],
        [str(llama), "--host", "127.0.0.1", "--port", "8179", "-m", str(translation),
         "--alias", "translator", "-c", "4096", "-t", "6", "-ngl", "0" if cpu else "99", "--parallel", "1"]
    ]
    (ROOT / "runtime/logs").mkdir(parents=True, exist_ok=True)
    children, logs = [], []
    pidfile = ROOT / "runtime/models-process.json"
    identity = {"pid": os.getpid(), "start_ticks": Path(f"/proc/{os.getpid()}/stat").read_text().split()[21]}
    stopped = False
    def stop(_signal, _frame):
        nonlocal stopped
        stopped = True
    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)
    try:
        for name, command in zip(["asr", "translation"], commands):
            log = (ROOT / f"runtime/logs/{name}.log").open("w")
            logs.append(log)
            children.append(subprocess.Popen(command, stdout=log, stderr=log))
        pidfile.write_text(json.dumps(identity) + "\n")
        print(f"Loading models (SenseVoice CPU + translation {'CPU' if cpu else 'Vulkan'}). Logs: {ROOT / 'runtime/logs'}", flush=True)
        deadline = time.monotonic() + 180
        ready = False
        while not stopped:
            if any(child.poll() is not None for child in children):
                raise RuntimeError("A model process exited. Inspect runtime/logs; no automatic CPU fallback was used.")
            if not ready:
                try:
                    # Bypass external proxies for local model checks.
                    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
                    for url in ["http://127.0.0.1:8178/", "http://127.0.0.1:8179/health"]:
                        with opener.open(url, timeout=1) as response:
                            if response.status != 200:
                                raise OSError("Not ready")
                    ready = True
                    print("Both models ready. Run bin/run. Ctrl+C here stops both model services.", flush=True)
                except OSError:
                    if time.monotonic() > deadline:
                        raise RuntimeError("Model startup timed out. Inspect runtime/logs.")
            time.sleep(0.5)
    finally:
        for child in children:
            if child.poll() is None:
                child.terminate()
        for child in children:
            try:
                child.wait(timeout=8)
            except subprocess.TimeoutExpired:
                child.kill()
                child.wait()
        for log in logs:
            log.close()
        if pidfile.exists() and json.loads(pidfile.read_text()) == identity:
            pidfile.unlink()

if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, ValueError) as error:
        sys.exit(str(error))
