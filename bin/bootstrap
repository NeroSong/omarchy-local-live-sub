#!/usr/bin/env python3
"""Build isolated inference tools and verify model downloads; no system installation."""
import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time
import urllib.request

from model_assets import ASR_REPO, ASR_FILES, asr_directory, translation_path, checksum, download_verified
from app_paths import AppPaths
from lifecycle import acquire_lock, atomic_json, private_directory

ROOT = Path(__file__).resolve().parent.parent

def run(*args):
    subprocess.run(args, check=True)

def api(url):
    for attempt in range(5):
        try:
            with urllib.request.urlopen(url, timeout=60) as response:
                return json.load(response)
        except OSError:
            if attempt == 4:
                raise
            time.sleep(2 + attempt)

def model(repo, match, destination, lock):
    paths = AppPaths(ROOT)
    with acquire_lock(paths.runtime / "translation-download.lock") as guard:
        _model_locked(repo, match, destination, lock)

def _model_locked(repo, match, destination, lock):
    pinned = json.loads((ROOT / "dependencies.lock.json").read_text()).get(repo, {})
    if all(pinned.get(key) for key in ("revision", "file", "sha256")):
        revision, filename, expected, size = pinned["revision"], pinned["file"], pinned["sha256"], pinned.get("size")
        if not match(filename):
            raise RuntimeError("Requested model does not match dependencies.lock.json")
    else:
        info = api(f"https://huggingface.co/api/models/{repo}?blobs=true")
        files = [f for f in info["siblings"] if match(f["rfilename"])]
        if len(files) != 1:
            raise RuntimeError(f"Expected one matching model in {repo}")
        entry = files[0]
        revision, filename = info["sha"], entry["rfilename"]
        expected, size = entry.get("lfs", {}).get("sha256"), entry.get("lfs", {}).get("size")
        if not expected:
            raise RuntimeError(f"Missing published SHA256 for {filename}")
    url = os.environ.get("TRANSLATION_DOWNLOAD_URL", f"https://huggingface.co/{repo}/resolve/{revision}/{filename}")
    paths = AppPaths(ROOT)
    if destination != paths.models / "translation.gguf":
        if not destination.is_file() or checksum(destination) != expected:
            raise RuntimeError(f"Existing external model differs from the pinned checksum: {destination}. No existing model was changed.")
    else:
        download_verified(url, destination, expected, size)
    lock[repo] = {"revision": revision, "file": filename, "sha256": expected, "size": size}


def prepare_asr(lock, force_download=False):
    pinned = json.loads((ROOT / "dependencies.lock.json").read_text())[ASR_REPO]
    destination = asr_directory(ROOT)
    complete = all((destination / name).is_file() for name in ASR_FILES)
    if os.environ.get("SENSEVOICE_MODEL_DIR") and (force_download or not complete):
        raise RuntimeError("SENSEVOICE_MODEL_DIR must point to a complete model directory. Unset it to download the bundled model.")
    if force_download or not complete:
        destination = AppPaths(ROOT).models / "sensevoice-small-fp32"
        private_directory(destination)
        with acquire_lock(destination / ".download.lock") as guard:
            for filename, details in pinned["files"].items():
                download_verified(f"https://huggingface.co/{ASR_REPO}/resolve/{pinned['revision']}/{filename}",
                    destination / filename, details["sha256"], details["size"])
    else:
        for filename in ASR_FILES:
            if checksum(destination / filename) != pinned["files"][filename]["sha256"]:
                raise RuntimeError(f"{destination / filename} differs from the pinned SenseVoice model. No existing model was changed. Use --download-asr without SENSEVOICE_MODEL_DIR to prepare the bundled model.")
        print(f"Verified existing SenseVoice model (read-only): {destination}", flush=True)
    lock["active_asr"] = {"engine": "sensevoice", "model": "small-fp32", "directory": str(destination), "default_language": "auto"}


def clone_source(name, url, path, pinned):
    expected = pinned[name]
    if path.exists():
        if not (path / '.git').is_dir():
            raise RuntimeError(f'{path} is not a managed git checkout. Existing files were not changed.')
        remote = subprocess.check_output(['git', '-C', str(path), 'remote', 'get-url', 'origin'], text=True).strip()
        if remote != url:
            raise RuntimeError(f'{path} uses an unexpected remote. Existing source was not changed.')
        head = subprocess.run(['git', '-C', str(path), 'rev-parse', '--verify', 'HEAD'], capture_output=True, text=True)
        if head.returncode == 0:
            if head.stdout.strip() != expected:
                raise RuntimeError(f'{path} uses {head.stdout.strip()}, expected {expected}. Existing source was not changed.')
            return
        status = subprocess.check_output(['git', '-C', str(path), 'status', '--porcelain', '--untracked-files=all'], text=True)
        if status.strip():
            raise RuntimeError(f'{path} has files in an interrupted checkout. Preserve them before retrying.')
    else:
        run('git', 'init', str(path))
        run('git', '-C', str(path), 'remote', 'add', 'origin', url)
    run('git', '-C', str(path), 'fetch', '--depth', '1', 'origin', expected)
    run('git', '-C', str(path), 'checkout', '--detach', 'FETCH_HEAD')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--cpu", action="store_true", help="build CPU only, without Vulkan development headers")
    parser.add_argument("--tools-only", action="store_true", help="skip model downloads")
    parser.add_argument("--models-only", action="store_true", help="download and verify models without building tools")
    parser.add_argument("--only-model", choices=["asr", "translation"], help="prepare only one selected model")
    parser.add_argument("--download-asr", action="store_true", help="download the pinned SenseVoice model into the user cache even if Voxtype already has one")
    args = parser.parse_args()
    if os.geteuid() == 0:
        raise RuntimeError("Run bootstrap as the normal desktop user, not root.")
    paths = AppPaths(ROOT)
    paths.initialize()
    if not (3, 12) <= sys.version_info[:2] <= (3, 14):
        raise RuntimeError("Python 3.12-3.14 is required by the pinned inference wheels")
    if args.tools_only and (args.models_only or args.only_model or args.download_asr):
        parser.error("--tools-only cannot be combined with model preparation flags")
    required = [] if args.models_only else ["git", "cmake", "make", "g++", "ffmpeg", "pactl"]
    if not args.models_only and not paths.packaged:
        required.append("qmake6")
    if not args.models_only and not args.cpu:
        required.append("glslc")
    missing = [name for name in required if not shutil.which(name)]
    if missing:
        raise RuntimeError("Missing tools: " + ", ".join(missing))
    runtime = paths.runtime
    bootstrap_guard = acquire_lock(runtime / "bootstrap.lock")
    manifest = runtime / "manifest.json"
    lock = json.loads(manifest.read_text()) if manifest.exists() else {}
    def save_manifest():
        with acquire_lock(runtime / "manifest.lock"):
            current = json.loads(manifest.read_text()) if manifest.exists() else {}
            current.update(lock)
            atomic_json(manifest, current)
    if not args.tools_only:
        if args.only_model != "translation":
            prepare_asr(lock, args.download_asr)
            save_manifest()
        repo = os.environ.get("TRANSLATION_REPO", "tencent/Hy-MT2-1.8B-GGUF")
        quant = os.environ.get("TRANSLATION_QUANT", "Q8_0")
        if args.only_model != "asr":
            model(repo, lambda f: f.endswith("-" + quant + ".gguf"), translation_path(ROOT), lock)
            save_manifest()
    if args.models_only:
        return
    for environment, requirements in [("sensevoice-venv", "requirements.txt"), ("hotword-venv", "requirements-hotwords.txt")]:
        venv = runtime / environment
        if not (venv / "bin/python").is_file():
            run(sys.executable, "-m", "venv", str(venv))
        run(str(venv / "bin/python"), "-m", "pip", "install", "-r", str(ROOT / requirements))
    pinned = json.loads((ROOT / "dependencies.lock.json").read_text())
    vulkan_args = []
    if not args.cpu and not Path("/usr/include/vulkan/vulkan.h").exists():
        headers = runtime / "Vulkan-Headers"
        clone_source("Vulkan-Headers", "https://github.com/KhronosGroup/Vulkan-Headers.git", headers, pinned)
        lock["Vulkan-Headers"] = subprocess.check_output(["git", "-C", str(headers), "rev-parse", "HEAD"], text=True).strip()
        vulkan_args = ["-DVulkan_INCLUDE_DIR=" + str(headers / "include")]
    if not args.cpu:
        spirv = runtime / "SPIRV-Headers"
        clone_source("SPIRV-Headers", "https://github.com/KhronosGroup/SPIRV-Headers.git", spirv, pinned)
        lock["SPIRV-Headers"] = subprocess.check_output(["git", "-C", str(spirv), "rev-parse", "HEAD"], text=True).strip()
        prefix = runtime / "sdk"
        run("cmake", "-S", str(spirv), "-B", str(spirv / "build"), "-DCMAKE_INSTALL_PREFIX=" + str(prefix))
        run("cmake", "--install", str(spirv / "build"))
        vulkan_args += ["-DCMAKE_PREFIX_PATH=" + str(prefix), '-DCMAKE_CXX_FLAGS=-I"' + str(prefix / "include") + '"']
    for name, target in [("llama.cpp", "llama-server")]:
        source = runtime / name
        clone_source(name, f"https://github.com/ggml-org/{name}.git", source, pinned)
        lock[name] = subprocess.check_output(["git", "-C", str(source), "rev-parse", "HEAD"], text=True).strip()
        build = source / "build"
        run("cmake", "-S", str(source), "-B", str(build), "-DCMAKE_BUILD_TYPE=Release",
            "-DGGML_VULKAN=" + ("OFF" if args.cpu else "ON"), "-DGGML_NATIVE=ON",
            "-DWHISPER_BUILD_TESTS=OFF", "-DLLAMA_BUILD_TESTS=OFF", "-DLLAMA_CURL=OFF", *vulkan_args)
        run("cmake", "--build", str(build), "--target", target, "-j", os.environ.get("BUILD_JOBS", "4"))
    lock["acceleration"] = "cpu" if args.cpu else "vulkan"
    save_manifest()
    if not paths.packaged:
        run(str(ROOT / "bin/build"))
    print("Ready. Run ./bin/start to open the app, or ./bin/doctor to check this installation.")

if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        sys.exit(f"Setup failed: {error}")
