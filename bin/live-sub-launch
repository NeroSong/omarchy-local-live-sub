#!/usr/bin/env python3
"""Installed entry point. Programs are read-only; all generated data uses XDG paths."""
import os
from pathlib import Path
import shutil
import subprocess
import sys

location = Path(__file__).resolve()
source = location.parent.parent
root = Path(os.environ.get('LIVE_SUB_ROOT') or (source if (source / 'bin/start').is_file() else source / 'share/live-sub')).resolve()
sys.path.insert(0, str(root / 'bin'))
sys.dont_write_bytecode = True


def main():
    from app_paths import AppPaths
    paths = AppPaths(root)
    args = sys.argv[1:]
    if not args or args[0] not in ('--help', '-h', '--paths'):
        paths.export()
    if args and args[0] in ('--help', '-h'):
        print('Usage: live-sub [--setup [options] | --doctor [options] | --stop | --status | --paths | --demo | window options]')
        print('  --setup --help     Prepare private per-user models and runtime (no sudo).')
        print('  --setup --migrate-from PATH   Copy missing old config/settings/sessions; keep originals.')
        print('  --paths            Show resource and user directory paths without creating files.')
        print('Uninstalling the package removes code only. User config, captions, cache and runtime are retained.')
        return 0
    if args and args[0] == '--paths':
        import json
        print(json.dumps(paths.values(), indent=2))
        return 0
    if args and args[0] == '--demo':
        paths.initialize()
        return subprocess.call([str(paths.binary), *args], cwd=paths.home)
    commands = {'--setup':'setup', '--doctor':'doctor', '--stop':'models-stop'}
    script = commands.get(args[0], 'start') if args else 'start'
    if args and args[0] in commands:
        args = args[1:]
    os.environ['LIVE_SUB_FOREGROUND'] = '1'
    return subprocess.call([sys.executable, str(root / 'bin' / script), *args], cwd=paths.home)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (ImportError, OSError, RuntimeError, ValueError) as error:
        message = str(error)
        print(message, file=sys.stderr)
        if shutil.which('notify-send'):
            subprocess.run(['notify-send', '--app-name=Omarchy Local Live Sub', '--urgency=critical', '字幕应用无法启动', message])
        sys.exit(1)
