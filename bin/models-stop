#!/usr/bin/env python3
"""Stop only the recorded model supervisor, after checking its process identity."""
import argparse
import os
from pathlib import Path
import signal
import sys
import time

from app_paths import AppPaths
from lifecycle import process_stat, read_owned


def main():
    argparse.ArgumentParser(description=__doc__).parse_args()
    paths = AppPaths()
    root = paths.root
    path = paths.state / 'models-process.json'
    record = read_owned(path, root)
    if not record:
        if path.exists():
            raise RuntimeError('No matching supervisor identity. No process was stopped.')
        print('No running model supervisor recorded for this project.')
        return
    pid, ticks = record['pid'], record['start_ticks']
    # Linux pidfd closes the identity-check-to-signal PID reuse race when supported.
    if hasattr(os, 'pidfd_open') and hasattr(signal, 'pidfd_send_signal'):
        fd = os.pidfd_open(pid)
        try:
            if read_owned(path, root) != record:
                raise RuntimeError('Process identity changed; no process was stopped.')
            signal.pidfd_send_signal(fd, signal.SIGTERM)
        finally:
            os.close(fd)
    else:
        if read_owned(path, root) != record:
            raise RuntimeError('Process identity changed; no process was stopped.')
        os.kill(pid, signal.SIGTERM)
    print('Stopping this project\'s two model services.', flush=True)
    deadline = time.monotonic() + 20
    while True:
        try:
            state, current = process_stat(pid)
            if state == 'Z' or current != ticks:
                break
        except FileNotFoundError:
            break
        if time.monotonic() >= deadline:
            raise RuntimeError('Supervisor is still exiting; no additional process was killed. Wait before restarting.')
        time.sleep(0.1)
    print('Model services stopped.')


if __name__ == '__main__':
    try:
        main()
    except (OSError, RuntimeError, ValueError) as error:
        sys.exit(str(error))
