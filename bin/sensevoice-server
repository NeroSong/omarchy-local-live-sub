#!/usr/bin/env python3
"""Project-only loopback ASR adapter; never uses Voxtype state or audio capture."""
from email.parser import BytesParser
from email.policy import default
from http.server import BaseHTTPRequestHandler, HTTPServer
import io
import json
import os
from pathlib import Path
import re
import wave
import numpy as np

from model_assets import asr_directory

root = Path(__file__).resolve().parent.parent
model = asr_directory(root)
config_dir = Path(os.environ.get('LIVE_SUB_CONFIG_DIR', str(root))).resolve()
config_path = config_dir / 'asr-config.json'
config = json.loads(config_path.read_text())
mode = os.environ.get('SENSEVOICE_DECODER', config['decoder'])
if mode == 'hotword_ctc':
    from hotword_decoder import Recognizer, LiveDecoderConfig
    recognizer = Recognizer(model, config)
    live_config = LiveDecoderConfig(config_path, recognizer.decoder.tokens, recognizer.decoder.blank, config)
    def refresh_config():
        global config
        live_config.refresh()
        recognizer.decoder = live_config.decoder
        config = live_config.config
        return {'config_revision':live_config.revision, 'config_error':live_config.error}
    def decode(samples, language):
        return recognizer.decode(samples, language)
elif mode == 'greedy':
    def refresh_config():
        return {'config_revision':'', 'config_error':''}
    import sherpa_onnx
    recognizers = {}
    for language in ('zh', 'en', 'auto'):
        recognizers[language] = sherpa_onnx.OfflineRecognizer.from_sense_voice(
            model=str(model / 'model.onnx'), tokens=str(model / 'tokens.txt'),
            num_threads=6, language=language, use_itn=True, provider='cpu')
    def decode(samples, language):
        engine = recognizers[language]
        stream = engine.create_stream()
        stream.accept_waveform(16000, samples)
        engine.decode_stream(stream)
        result = stream.result
        return {'text': result.text, 'language': getattr(result, 'lang', '').replace('<|', '').replace('|>', ''), 'decoder': 'greedy'}
else:
    raise ValueError('Unsupported SENSEVOICE_DECODER: ' + mode)

class Handler(BaseHTTPRequestHandler):
    def respond(self, code, data):
        body = json.dumps(data, ensure_ascii=False).encode()
        self.send_response(code)
        self.send_header('Content-Type', 'application/json; charset=utf-8')
        self.send_header('Content-Length', str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        status = refresh_config()
        self.respond(200, {'engine': 'sensevoice', 'model': str(model), 'languages': ['zh', 'en'], 'decoder': mode,
            'hotwords': [entry['term'] for entry in config['hotwords']] if mode == 'hotword_ctc' else [],
            'config_directory': str(config_dir), **status})

    def do_POST(self):
        if self.path != '/inference':
            return self.respond(404, {'error': 'Unknown endpoint'})
        try:
            length = int(self.headers.get('Content-Length', '0'))
            if not 0 < length <= 2 * 1024 * 1024:
                raise ValueError('Invalid audio size')
            content_type = self.headers.get('Content-Type', '')
            message = BytesParser(policy=default).parsebytes(
                ('Content-Type: ' + content_type + '\r\nMIME-Version: 1.0\r\n\r\n').encode() + self.rfile.read(length))
            fields = {part.get_param('name', header='content-disposition'): part.get_payload(decode=True)
                      for part in message.iter_parts()}
            language = fields.get('language', b'auto').decode()
            if language not in ('auto', 'zh', 'en'):
                raise ValueError('Only zh, en and auto are supported')
            with wave.open(io.BytesIO(fields['file']), 'rb') as audio:
                if (audio.getnchannels(), audio.getsampwidth(), audio.getframerate()) != (1, 2, 16000):
                    raise ValueError('Expected mono 16kHz PCM16 WAV')
                samples = np.frombuffer(audio.readframes(audio.getnframes()), dtype='<i2').astype(np.float32) / 32768
            status = refresh_config()
            result = decode(samples, language)
            detected = result['language']
            # Auto mode must not pass Korean/Japanese output into a Chinese-English discussion.
            if language == 'auto' and (detected in ('ja', 'ko', 'yue') or re.search('[\u3040-\u30ff\uac00-\ud7af]', result['text'])):
                result = decode(samples, 'zh')
                detected = 'zh'
            result['text'] = re.sub(r'<\|[^|]*\|>', '', result['text']).strip()
            result['language'] = detected or language
            result.update(status)
            self.respond(200, result)
        except (ValueError, KeyError, wave.Error) as error:
            self.respond(400, {'error': str(error)})
        except Exception as error:
            self.respond(500, {'error': str(error)})

port = int(os.environ.get('LIVE_SUB_ASR_PORT', '8178'))
print(f'SenseVoice Small FP32 ready on 127.0.0.1:{port} (CPU, decoder={mode})', flush=True)
HTTPServer(('127.0.0.1', port), Handler).serve_forever()
