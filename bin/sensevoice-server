#!/usr/bin/env python3
"""Project-only loopback ASR adapter; never uses Voxtype state or audio capture."""
import json
import os
from pathlib import Path
import sys
import numpy as np

from asr_service import ASRService, BoundedASRServer
from lifecycle import read_token
from model_assets import asr_directory


def main():
    root = Path(__file__).resolve().parent.parent
    model = asr_directory(root)
    config_dir = Path(os.environ.get('LIVE_SUB_CONFIG_DIR', str(root))).resolve()
    config_path = config_dir / 'asr-config.json'
    config = json.loads(config_path.read_text())
    mode = os.environ.get('SENSEVOICE_DECODER', config['decoder'])
    if mode == 'hotword_ctc':
        from hotword_decoder import Recognizer, LiveDecoderConfig
        recognizer = Recognizer(model, config)
        live_config = LiveDecoderConfig(config_path, recognizer.decoder.tokens, recognizer.decoder.blank, config)

        def refresh_config():
            live_config.refresh()
            recognizer.decoder = live_config.decoder
            return {
                'config_revision': live_config.revision,
                'config_error': live_config.error,
                'hotwords': [entry['term'] for entry in live_config.config['hotwords']],
            }

        def decode(pcm, language):
            samples = np.frombuffer(pcm, dtype='<i2').astype(np.float32) / 32768
            return recognizer.decode(samples, language)
    elif mode == 'greedy':
        import sherpa_onnx
        recognizers = {}
        for language in ('zh', 'en', 'auto'):
            recognizers[language] = sherpa_onnx.OfflineRecognizer.from_sense_voice(
                model=str(model / 'model.onnx'), tokens=str(model / 'tokens.txt'),
                num_threads=int(config.get('threads', 6)), language=language, use_itn=True, provider='cpu')

        def refresh_config():
            return {'config_revision': '', 'config_error': '', 'hotwords': []}

        def decode(pcm, language):
            samples = np.frombuffer(pcm, dtype='<i2').astype(np.float32) / 32768
            engine = recognizers[language]
            stream = engine.create_stream()
            stream.accept_waveform(16000, samples)
            engine.decode_stream(stream)
            result = stream.result
            return {'text': result.text, 'language': getattr(result, 'lang', '').replace('<|', '').replace('|>', ''),
                    'decoder': 'greedy'}
    else:
        raise ValueError('Unsupported SENSEVOICE_DECODER: ' + mode)

    service = ASRService(decode, refresh_config, {
        'engine': 'sensevoice', 'model': str(model), 'languages': ['zh', 'en'],
        'decoder': mode, 'config_directory': str(config_dir),
    })
    port = int(os.environ.get('LIVE_SUB_ASR_PORT', '8178'))
    token = read_token(os.environ.get('LIVE_SUB_API_TOKEN_FILE', ''))
    if not token:
        sys.exit('LIVE_SUB_API_TOKEN_FILE must name a private token file; start this service with bin/models-start.')
    with BoundedASRServer(('127.0.0.1', port), service, token=token) as server:
        print(f'SenseVoice Small FP32 ready on 127.0.0.1:{port} (CPU, decoder={mode})', flush=True)
        server.serve_forever()


if __name__ == '__main__':
    main()
